// Dinero Licensing Backend — Postgres schema (Neon), deployed via Vercel Serverless.
// Doc 30 TASK-LIC-001, matching Doc 17 §4.1-§4.2 exactly.
//
// Doc 17/40 give full column detail only for `accounts` and `plans`; the other
// four tables are named with purpose + isolation key only ("carried forward
// from existing source material" that was never itself published in this doc
// set). Columns below are reconstructed from every scattered cross-reference
// that names a concrete field (Doc 19 §14.1-§14.2, Doc 22's device-binding
// design, Doc 40 §4/§11/§14) — flagged here, not silently invented, per this
// project's own documentation discipline. Revise once real Razorpay/JWT
// integration work (TASK-LIC-002 onward) surfaces a field this guess missed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// --- Doc 17 §4.1: Tenant Root ---------------------------------------------

model Account {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique @db.Citext
  fullName    String?  @map("full_name")
  countryCode String?  @default("IN") @map("country_code") @db.Char(2)
  trialUsed   Boolean  @default(false) @map("trial_used")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions          Subscription[]
  licenseTokens          LicenseToken[]
  paymentProviderRecords PaymentProviderRecord[]
  auditLogEntries        LicensingAuditLog[]

  @@map("accounts")
}

// --- Doc 40 §11: shared reference data, NOT tenant-scoped ------------------

model Plan {
  /// e.g. "desktop_pro_monthly" / "desktop_pro_annual" (Doc 19 §14.1 plan_id)
  id              String   @id
  name            String
  currency        String   @default("INR")
  /// Doc 03 §3: 29900 (₹299.00/mo), 287040 (₹2,870.40/yr). NOT a user
  /// transaction amount — this is Dinero's own subscription price, business
  /// reference data explicitly permitted alongside the hard "no financial
  /// data" schema constraint (Doc 30 TASK-LIC-001) that governs every other
  /// table here. See tests/schema.test.ts's denylist for the exact reasoning.
  amountMinor     Int      @map("amount_minor")
  billingInterval String   @map("billing_interval") // "month" | "year"
  trialDays       Int      @default(14) @map("trial_days")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("plans")
}

// --- Doc 17 §4.2: dependent tables, FK-scoped to accounts.id ---------------

model Subscription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  planId             String    @map("plan_id")
  /// trialing | active | past_due | grace | locked | canceled | expired
  /// (Doc 18 §4.22's local license_state.subscription_status_cached mirror)
  status             String
  /// Mirrored from plans.billing_interval at creation time so a later plan
  /// price/cadence change never silently alters an existing subscriber's
  /// terms (Doc 40 §11).
  billingInterval    String    @map("billing_interval")
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  account                Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan                   Plan                    @relation(fields: [planId], references: [id])
  paymentProviderRecords PaymentProviderRecord[]

  @@index([accountId])
  @@map("subscriptions")
}

/// Corrected during TASK-BILL-002 (real conflict found and resolved, see
/// Doc 30 changelog): there is no user-facing "license_key" concept in this
/// system at all -- activation is a direct Razorpay payment confirmation
/// (Doc 19 §14.2), and `device_id` alone is the lookup key for validate/
/// deactivate/refresh (one device is bound to at most one account's
/// license at a time), matching the already-shipped, tested desktop client
/// (`src-tauri/src/licensing/client.rs`) exactly. This table now tracks
/// device-binding + JWT-issuance state per account, not a redeemable key.
model LicenseToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Hardware-UUID-derived fingerprint (Doc 22, Doc 19 §14.2's device_id) —
  /// nullable until first activation binds a device. Unique when non-null:
  /// Postgres permits multiple NULLs under a UNIQUE constraint, so many
  /// not-yet-bound rows can coexist, but a real device can only ever be
  /// bound to exactly one account's token row at a time.
  deviceFingerprint String?   @unique @map("device_fingerprint")
  deviceBoundAt     DateTime? @map("device_bound_at") @db.Timestamptz
  jwtIssuedAt       DateTime? @map("jwt_issued_at") @db.Timestamptz
  /// 24-72h expiry per Doc 19 §14.2 / Doc 30 TASK-LIC-002 — short-lived,
  /// requires periodic revalidation, not a long-lived credential.
  jwtExpiresAt DateTime? @map("jwt_expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("license_tokens")
}

model PaymentProviderRecord {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid

  /// Doc 40 §4/§11: maps this account/subscription to Razorpay's own IDs.
  /// Never a card/bank/UPI identifier — Razorpay-issued opaque references only.
  razorpayCustomerId     String? @map("razorpay_customer_id")
  razorpaySubscriptionId String? @map("razorpay_subscription_id")
  razorpayPaymentId      String? @map("razorpay_payment_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([accountId])
  @@map("payment_provider_records")
}

/// Doc 17 §4.2: the one deliberate ON DELETE SET NULL exception — an audit
/// trail must survive the very deletion event it records (Doc 42 §5).
model LicensingAuditLog {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String? @map("account_id") @db.Uuid

  /// e.g. "signup" | "trial_started" | "license_activated" | "license_validated"
  /// | "subscription_created" | "invoice_paid" | "invoice_payment_failed" | ...
  eventType String @map("event_type")
  /// New in Doc 17 v1.5 (Documentation Audit C-03): backs Doc 40 §14's
  /// device-level trial-abuse check (has *this device* ever started a trial
  /// under *any* account) — accounts.trial_used alone only answers the
  /// email-keyed half of that question.
  deviceFingerprint String? @map("device_fingerprint")
  payload           Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([eventType])
  @@map("licensing_audit_log")
}
