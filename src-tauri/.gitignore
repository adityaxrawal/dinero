# Generated by Cargo
# will have compiled files and executables
/target/

# Alternate build directories from a non-default CARGO_TARGET_DIR, e.g. a
# one-off `CARGO_TARGET_DIR=target-cleancheck cargo check` used to compile a
# scratch copy of the tree without disturbing the primary target/.
#
# These are build output exactly like /target/, but the pattern above does not
# match them: a 641 MB `target-cleancheck/` once surfaced as ~3,700 "untracked"
# files, which is noisy enough to bury a real change in `git status`.
/target-*/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

/dinero-docs
