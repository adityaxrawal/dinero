{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dinero",
  "version": "0.1.0",
  "identifier": "com.dinero.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Dinero",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://license.dinero.app; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        {
          "identifier": "default",
          "description": "Capability for the main window",
          "windows": ["main"],
          "permissions": ["core:default", "opener:default", "dialog:default", "fs:allow-read-file", "notification:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "api.dinero-app.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dinero-app/dinero-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRjZCNTA1N0Q1MEQ5Q0MKUldUTTJWQjlCYlgybXpJMzlUS1Y4LzNHZTE1ZFJGREJCNU1JOTBWUGRKRjZWb1crQmZwc0JPRXMK"
    }
  }
}
